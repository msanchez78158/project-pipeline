# Required only for live Python model calls. Never commit .env.
OPENROUTER=replace_with_your_openrouter_key
# Inherited defaults; replace with models available in your OpenRouter account.
PIPELINE_INGEST_MODEL=google/gemma-4-31b-it
PIPELINE_ANALYSIS_MODEL=deepseek/deepseek-v4-flash
PIPELINE_SYNTHESIS_MODEL=anthropic/claude-sonnet-4-5
# Optional local demo-data generator settings (not needed for offline tests).
FRED_API_KEY=replace_with_your_fred_key
PRIME_RATE_OVERRIDE=8.50
